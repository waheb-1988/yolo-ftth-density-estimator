# ── FALCON Environment Configuration ─────────────────────────────────────────
# Copy this file to .env and adjust values for your environment.
# .env is git-ignored; never commit real credentials.

# ── Paths ──────────────────────────────────────────────────────────────────────
# FALCON_DATA_DIR=./data
# FALCON_OUTPUTS_DIR=./outputs

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_TO_FILE=true

# ── API / Dashboard Ports ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501

# ── YOLO Model ─────────────────────────────────────────────────────────────────
# Model size: n (nano) | s (small) | m (medium) | l (large) | x (xlarge)
YOLO_MODEL_SIZE=n
YOLO_CONF=0.25

# ── Satellite Imagery ──────────────────────────────────────────────────────────
# Set USE_REAL_TILES=true to download actual map tiles (OSM) instead of synthetic images
USE_REAL_TILES=false
TILE_PROVIDER=osm

# ── Financial Constants (OMR) ──────────────────────────────────────────────────
ARPU_MONTHLY_OMR=5.5
HOUSEHOLD_SIZE=4
FTTH_UPTAKE_RATE=0.42
COST_PER_CABINET_OMR=25000
HOMES_PER_CABINET=150

# ── Scoring Weights (must sum to 1.0) ─────────────────────────────────────────
WEIGHT_VEHICLE_DENSITY=0.40
WEIGHT_COVERAGE_GAP=0.35
WEIGHT_POPULATION_DENSITY=0.25

# ── Competitive Landscape ──────────────────────────────────────────────────────
WAHEB_MARKET_SHARE=10.0
RAMI_MARKET_SHARE=35.0
DON_MARKET_SHARE=25.0
UNSERVED_MARKET_SHARE=30.0
TOTAL_MUSCAT_HOMES=350000
WAHEB_TARGET_SHARE_2026=25.0
