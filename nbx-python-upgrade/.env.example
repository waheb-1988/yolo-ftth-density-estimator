# Copy to .env and edit. Every value has a default, so .env is optional.
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env

# --- LLM backend -------------------------------------------------------------
# offline : pure Python, no server, no model download (default).
#           Every agent runs its deterministic policy.
# vllm    : vLLM server, OpenAI-compatible API (Linux GPU server, or WSL2: python run.py vllm-serve).
# ollama  : disabled -- the agents use vLLM. To re-enable, uncomment the two Ollama lines below.
LLM_BACKEND=offline
DEFAULT_LLM=mistral:7b
LLM_TIMEOUT_S=300

# Ollama (disabled): with OLLAMA_ENABLED=0 the app never calls Ollama, LLM_BACKEND=ollama is
# refused, and the Qwen3-Embedding models (served by Ollama) are unavailable.
OLLAMA_ENABLED=0
# OLLAMA_URL=http://localhost:11434
VLLM_URL=http://127.0.0.1:8001
# Must match `vllm serve --api-key` if you set one. Never commit a real key.
VLLM_API_KEY=
VLLM_MAX_TOKENS=1024
# Model served by `python run.py vllm-serve` (WSL2); the served name must match DEFAULT_LLM.
# VLLM_HF_MODEL=Qwen/Qwen2.5-3B-Instruct-GPTQ-Int4
# VLLM_SERVED_NAME=qwen2.5:3b

# --- Retrieval ---------------------------------------------------------------
# graph  : knowledge-graph retrieval, no embeddings needed (default)
# vector : embedded vector store (run `python run.py setup` first)
DEFAULT_RETRIEVAL_MODE=graph
DEFAULT_VECTORSTORE=chroma
DEFAULT_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Ports -------------------------------------------------------------------
FASTAPI_PORT=8000
GRADIO_PORT=7860

# Native-language SMS (Hindi / Urdu / Bengali): template (reviewed templates, default) | llm (model-written, checked)
MESSENGER_NATIVE_SOURCE=template

# --- Paths / logging ---------------------------------------------------------
# Defaults to <project>/data. Use an absolute path if you override it.
# DATA_DIR=C:/path/to/nbx-data
LOG_LEVEL=INFO

# --- FSDR (docs/fsdr_plan.md) -------------------------------------------------
OPERATOR_NAME=FSDR
FSDR_CURRENCY=OMR
# Run folders data/fsdr/<YYYY-MM-DD>/ live here (default <project>/data/fsdr).
# FSDR_DATA_DIR=C:/path/to/fsdr-data
# Test-sample table name of the current campaign (plan Q16).
FSDR_TARGET_SAMPLE_TABLE=sample_cg_tg_new_7oct2026
# Constraint-arm generosity (BR-66): all_L2 (currently active in production) | normal
FSDR_GENEROSITY_MAPPING=all_L2
# Agents: the code runs the required evidence tools before the first LLM call (0 = the LLM calls them)
FSDR_AGENT_PREFETCH=1
# Customers decided in parallel in batch runs (default 8 on vLLM, 4 otherwise)
# FSDR_AGENT_CONCURRENCY=8
# Training labels: auto (last week's campaign log when it exists, else the targeting tables) | targeting | campaign_log
FSDR_LABEL_SOURCE=auto
# Reward (BR-40): any BTL in D-7..D-1 (production). true = also on or after the targeting date
FSDR_REWARD_AFTER_TARGETING=false
# Last-campaign features (PREV_ACTION, PREV_OFFER_TAKEN, DAYS_SINCE_LAST_BTL, NB_CONTACTS_LAST_4W) in the model
FSDR_LAST_CAMPAIGN_FEATURES=true
# Offers the ranker may propose: history (production: bought in the filtered history) | catalogue
FSDR_RANKER_ITEMS=history
# Offer ranker: bpr (implicit, default) | lightfm (only if the lightfm package is installed)
FSDR_RANKER=bpr
# llm arm: share of decisions replaced by a bandit sample (exploration, keeps the logs usable for learning)
FSDR_EPSILON_LLM=0.1
# Catalogue services of the batch add-ons (comma-separated)
FSDR_ROAMING_SERVICES=ROAMING
FSDR_INTERNATIONAL_SERVICES=INTERNATIONAL
# Price-escalation guard: max week-over-week growth of the ARPU anchor (e.g. 0.1 = +10 %); empty = off
# FSDR_ANCHOR_MAX_GROWTH=0.1
# Operator names of your own competitor snapshot -> display labels (the shipped snapshot is already anonymised)
# FSDR_COMPETITOR_LABELS={"<name A>": "COMPETITOR_A", "<name B>": "COMPETITOR_B"}
# Competitor pages for the scraper (local file, git-ignored); see data/competitors/sources.example.json
# COMPETITOR_SOURCES_FILE=data/competitors/sources.json
