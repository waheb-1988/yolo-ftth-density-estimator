# Copy to .env and edit. Every value has a default, so .env is optional.
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# Never commit .env: it holds keys.

# --- LLM backend: everything runs ON THIS MACHINE -----------------------------------
# No cloud LLM API is used (no OpenAI, no Anthropic / Claude, no Hugging Face inference API). Pick one backend:
#   offline  : pure Python, no server, no model download (default). Every agent runs its deterministic policy.
#   vllm     : vLLM on a GPU (WSL2 on Windows, or Linux): uv run python run.py vllm-serve        -> VLLM_URL
#   ollama   : Ollama (Windows / macOS / Linux, CPU or GPU): install it, `ollama pull <model>`  -> OLLAMA_URL
#   llamacpp : llama.cpp `llama-server -m model.gguf --port 8080` (CPU or GPU)                 -> LLAMACPP_URL
#   lmstudio : LM Studio, Developer tab -> Start server (port 1234), load a model               -> LMSTUDIO_URL
# The four servers speak the OpenAI-compatible API; the app calls only the URL of the chosen backend.
LLM_BACKEND=offline
# The model name the agents ask for = the name the server answers to (vLLM --served-model-name, an Ollama tag,
# the LM Studio model id). If the server serves another model, the app uses the one it serves.
DEFAULT_LLM=qwen2.5:3b
LLM_TIMEOUT_S=300
VLLM_URL=http://127.0.0.1:8001
OLLAMA_URL=http://127.0.0.1:11434
LLAMACPP_URL=http://127.0.0.1:8080
LMSTUDIO_URL=http://127.0.0.1:1234
# Read by vLLM from the environment (never on its command line, review #19). Never commit a real key.
VLLM_API_KEY=
# Only if you protected the Ollama / llama.cpp / LM Studio server with a key.
LLM_API_KEY=
VLLM_MAX_TOKENS=512
# vLLM: the Hugging Face weights to serve and the name to serve them under (= DEFAULT_LLM). VLLM_OFFLINE=1 forbids
# any download once the model is cached (first serve downloads it once from Hugging Face).
# VLLM_HF_MODEL=Qwen/Qwen2.5-3B-Instruct-GPTQ-Int4
# VLLM_SERVED_NAME=qwen2.5:3b
# VLLM_OFFLINE=1
#
# --- Model catalogue (all open weights, run locally; pick one, set the lines of your backend) -------------
# Sizes: VRAM for vLLM 4-bit, RAM for Ollama / llama.cpp Q4. The agents need JSON output and ~2k-token prompts.
#
#  model                 | vLLM (VLLM_HF_MODEL / VLLM_SERVED_NAME)                  | Ollama tag (DEFAULT_LLM)  | GPU / RAM
#  Qwen2.5 3B (default)  | Qwen/Qwen2.5-3B-Instruct-GPTQ-Int4        / qwen2.5:3b   | qwen2.5:3b                | 4 GB
#  Qwen2.5 7B            | Qwen/Qwen2.5-7B-Instruct-AWQ              / qwen2.5:7b   | qwen2.5:7b                | 8 GB
#  Qwen2.5 14B           | Qwen/Qwen2.5-14B-Instruct-AWQ             / qwen2.5:14b  | qwen2.5:14b               | 12 GB
#  Qwen3 8B              | Qwen/Qwen3-8B-AWQ                          / qwen3:8b     | qwen3:8b                  | 8 GB
#  Llama 3.1 8B          | hugging-quants/Meta-Llama-3.1-8B-Instruct-AWQ-INT4 / llama3.1:8b | llama3.1:8b     | 8 GB
#  Llama 3.2 3B          | meta-llama/Llama-3.2-3B-Instruct           / llama3.2:3b  | llama3.2:3b               | 4 GB
#  Mistral 7B v0.3       | TheBloke/Mistral-7B-Instruct-v0.2-AWQ      / mistral:7b   | mistral:7b                | 8 GB
#  Mistral Nemo 12B      | casperhansen/mistral-nemo-instruct-2407-awq / mistral-nemo:12b | mistral-nemo:12b    | 10 GB
#  Gemma 2 9B            | (gated on Hugging Face: accept the licence)  / gemma2:9b    | gemma2:9b                 | 10 GB
#  Phi-3.5 mini 3.8B     | microsoft/Phi-3.5-mini-instruct            / phi3.5:3.8b  | phi3.5:3.8b               | 4 GB
#  DeepSeek-R1 distill 7B| casperhansen/deepseek-r1-distill-qwen-7b-awq / deepseek-r1:7b | deepseek-r1:7b       | 8 GB
#
# Examples:
#   Ollama + Qwen2.5 7B   : ollama pull qwen2.5:7b      then LLM_BACKEND=ollama   DEFAULT_LLM=qwen2.5:7b
#   llama.cpp + any GGUF  : llama-server -m qwen2.5-7b-instruct-q4_k_m.gguf --port 8080 --host 127.0.0.1
#                           then LLM_BACKEND=llamacpp  DEFAULT_LLM=qwen2.5:7b (any name: one model is served)
#   LM Studio             : load "qwen2.5-7b-instruct", Start server, then LLM_BACKEND=lmstudio DEFAULT_LLM=qwen2.5-7b-instruct
#   vLLM (GPU, WSL2)      : VLLM_HF_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ VLLM_SERVED_NAME=qwen2.5:7b, run.py vllm-serve,
#                           then LLM_BACKEND=vllm DEFAULT_LLM=qwen2.5:7b
#
# --- Local only (V4.0) -------------------------------------------------------------------------
# true (default): the app refuses any LLM server or tracing endpoint that is not on this machine (127.0.0.1,
# localhost, ::1), and Gradio / Hugging Face / vLLM usage analytics are off. To use your own GPU box on the LAN,
# list it here instead of switching this off.
FSDR_LOCAL_ONLY=true
# FSDR_LOCAL_HOSTS=192.168.1.50,gpu-box.local
# --- API security (review #5) ---------------------------------------------------
# With FSDR_API_KEY set, every /fsdr/* route needs the header X-API-Key (the web UI sends it).
# Required as soon as the API listens on anything else than 127.0.0.1.
FSDR_API_KEY=
# Forced promotion of a model the promotion rule refused: header X-Admin-Key. Empty = forced promotion disabled.
FSDR_ADMIN_KEY=
# Browser origins allowed to call the API (comma-separated).
FSDR_CORS_ORIGINS=http://localhost:7860,http://127.0.0.1:7860
# Salt of the customer pseudonyms in LLM prompts (review #8): any long random string, keep it private.
FSDR_PII_SALT=

# --- LangSmith tracing (nbx/core/tracing.py) -----------------------------------------
# Off unless both are set. With FSDR_LOCAL_ONLY=true it runs ONLY with a self-hosted LangSmith on this machine
# (LANGSMITH_ENDPOINT=http://127.0.0.1:...): the LangSmith cloud is refused. Every LLM call, tool call, agent, decision, journey step and weekly pipeline step becomes a
# run in LangSmith. Traces LEAVE THIS MACHINE: the MSISDN is never sent (salted pseudonym), but tool outputs carry the
# customer's features. For real customer data use a self-hosted LangSmith (LANGSMITH_ENDPOINT) or hide the payloads.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fsdr-recommender
# LANGSMITH_ENDPOINT=https://<your self-hosted LangSmith>
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true

# --- Ports / hosts -------------------------------------------------------------
FASTAPI_PORT=8000
GRADIO_PORT=7860
# FSDR_UI_HOST=127.0.0.1
# FSDR_API_URL=http://localhost:8000

# --- Paths / logging ---------------------------------------------------------
# DATA_DIR=C:/path/to/data
LOG_LEVEL=INFO

# --- FSDR data and business rules (docs/FSDR_HANDBOOK.md) ------------------------------
OPERATOR_NAME=FSDR
FSDR_CURRENCY=OMR
# Run folders <data>/fsdr/<YYYY-MM-DD>/ live here (default <project>/data/fsdr).
# FSDR_DATA_DIR=C:/path/to/fsdr-data
FSDR_TARGET_SAMPLE_TABLE=sample_cg_tg_new_7oct2026
# Constraint-arm generosity (BR-66): all_L2 (currently active in production) | normal
FSDR_GENEROSITY_MAPPING=all_L2
FSDR_AGENT_PREFETCH=1
# FSDR_AGENT_CONCURRENCY=8
FSDR_LABEL_SOURCE=auto
FSDR_REWARD_AFTER_TARGETING=false
FSDR_LAST_CAMPAIGN_FEATURES=true
FSDR_RANKER_ITEMS=history
FSDR_RANKER=bpr
FSDR_EPSILON_LLM=0.1
FSDR_ROAMING_SERVICES=ROAMING
FSDR_INTERNATIONAL_SERVICES=INTERNATIONAL

# --- V1.0 improvements. The value after "V0:" restores the previous behaviour. ---
# Offer arbitration (#10, #14): value = P(accept) x price inside the BR-66 families | price_band (V0: 3 passes)
FSDR_OFFER_POLICY=value
FSDR_OFFER_MARGIN=1.0
FSDR_OFFER_EXPLORATION=0.05
# Price floor of the value policy: anchor (production's floor, BR-78..82: offers priced above the ARPU anchor, no
# offer if the anchor is above every price) | none (also cheaper offers: more lines reached, needs business sign-off)
FSDR_OFFER_PRICE_FLOOR=anchor
# Promotion (#2, #3): paired_ci (champion vs challenger on the same holdout) | point (V0)
FSDR_PROMOTION_RULE=paired_ci
FSDR_PROMOTION_MARGIN=0.0
# Legacy targeting propensity (#1): deterministic | share (V0)
FSDR_TARGETING_PROPENSITY=deterministic
# Uplift reward (#4): true | false (V0)
FSDR_UPLIFT_REWARD=true
# Price-escalation guard (#9): max weekly growth of the ARPU anchor | off (V0)
FSDR_ANCHOR_MAX_GROWTH=0.10
# Missing-score flags + tenure (#11, #12): true | false (V0, production's feature list)
FSDR_EXTENDED_FEATURES=true
# Nationality as a model feature (#7, legal question): true | false
FSDR_USE_NATIONALITY=true

# V3.0 input contract (master §2): production inputs are <table>.csv.gz (FSDR CSV standard). true also accepts
# .csv / .json / .jsonl / .parquet that do not come from the dummy generator (tests, hand-made demo uploads).
FSDR_ALLOW_TEST_FORMATS=false
# V3.0 four groups (update prompt): sizes, T2 split, LLM weekly budget in hours, Target 1 guard mode
FSDR_T1_CONSTRAINT_SIZE=25000
FSDR_T1_FREE_SIZE=25000
FSDR_T2_CONSTRAINT_SIZE=25000
FSDR_T2_FREE_SIZE=25000
FSDR_CONTROL_SIZE=20000
FSDR_T2_SPLIT=true
FSDR_LLM_WEEKLY_BUDGET_H=10
FSDR_GUARD_MODE_TARGET1=repair
# --- V4.0 data layout and recommendations (docs/SETUP_NEW_LAPTOP.md) -----------------------
# Input of run date D: data/training/<D>/ (base, history, model scores) + data/scoring/<D>/ (this week's tables and
# the target lists target1|target2/a_constraint|b_free/ + control/). Results: data/output/<D>/target1|target2|control|push/.
# FSDR_TRAINING_DIR=C:/path/to/data/training
# FSDR_SCORING_DIR=C:/path/to/data/scoring
# FSDR_OUTPUT_DIR=C:/path/to/data/output
# Recommended offers per line: 6 = 3 monthly + 3 weekly (V4.0, slots 5 / 6 = the 3rd monthly / weekly);
# 4 = the V3.0 file (2 + 2, slots 5 / 6 for favourites and forced bundles only).
FSDR_RECO_OFFERS=6
